#!/bin/sh

# Colors
if [ "$TERM" != "dumb" ]; then
    C0="$(printf '\033[0m')"
    C1="$(printf '\033[1;31m')"
    C2="$(printf '\033[1;32m')"
    C3="$(printf '\033[1;33m')"
    C4="$(printf '\033[1;34m')"
    C5="$(printf '\033[1;35m')"
    C6="$(printf '\033[1;36m')"
else
    C0=""
    C1=""
    C2=""
    C3=""
    C4=""
    C5=""
    C6=""
fi

# Host
HOST="$(hostname 2>/dev/null)"

# Kernel
KERNEL="$(uname -sr)"

# Arch
ARCH="$(uname -m)"

# Uptime
if [ -r /proc/uptime ]; then
    UP="$(cut -d. -f1 /proc/uptime)"

    DAYS=$((UP / 86400))
    HOURS=$((UP % 86400 / 3600))
    MINS=$((UP % 3600 / 60))

    UPTIME=""

    [ "$DAYS" -gt 0 ] && UPTIME="${DAYS}d "
    [ "$HOURS" -gt 0 ] && UPTIME="${UPTIME}${HOURS}h "

    UPTIME="${UPTIME}${MINS}m"
else
    UPTIME="unknown"
fi

# CPU
CPU="$(grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^ //')"

if [ -z "$CPU" ]; then
    CPU="$(grep -m1 'Hardware' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^ //')"
fi

[ -z "$CPU" ] && CPU="unknown"

# Memory
if [ -r /proc/meminfo ]; then
    MEMTOTAL="$(grep MemTotal /proc/meminfo | awk '{print $2}')"
    MEMFREE="$(grep MemAvailable /proc/meminfo | awk '{print $2}')"

    [ -z "$MEMFREE" ] && MEMFREE="$(grep MemFree /proc/meminfo | awk '{print $2}')"

    USED=$(( (MEMTOTAL - MEMFREE) / 1024 ))
    TOTAL=$(( MEMTOTAL / 1024 ))

    MEMORY="${USED}M / ${TOTAL}M"
else
    MEMORY="unknown"
fi

# Shell
SHELL_NAME="$(basename "$SHELL" 2>/dev/null)"
[ -z "$SHELL_NAME" ] && SHELL_NAME="sh"

# Terminal
TERM_NAME="$TERM"
[ -z "$TERM_NAME" ] && TERM_NAME="unknown"

# Packages
#if command -v opkg >/dev/null 2>&1; then
#    PKG="$(opkg list-installed 2>/dev/null | wc -l)"
#elif command -v apk >/dev/null 2>&1; then
#    PKG="$(apk info 2>/dev/null | wc -l)"
#elif command -v dpkg >/dev/null 2>&1; then
#    PKG="$(dpkg -l 2>/dev/null | grep '^ii' | wc -l)"
#elif command -v rpm >/dev/null 2>&1; then
#    PKG="$(rpm -qa 2>/dev/null | wc -l)"
#else
#    PKG="unknown"
#fi

# Print helper
p() {
    printf "%b%-18s%b %s\n" "$C2" "$1" "$C0" "$2"
}

# Output
printf "\n"

printf "%b%-18s%b" "$C1" " _____ _____ ____  " "$C0"
p "Host:" "$HOST"

printf "%b%-18s%b" "$C2" "|_   _|_   _| __ ) " "$C0"
p "Kernel:" "$KERNEL"

printf "%b%-18s%b" "$C3" "  | |   | | |  _ \ " "$C0"
p "Arch:" "$ARCH"

printf "%b%-18s%b" "$C4" "  | |   | | | |_) |" "$C0"
p "Uptime:" "$UPTIME"

printf "%b%-18s%b" "$C5" "  |_|   |_| |____/ " "$C0"
p "CPU:" "$CPU"

printf "%b%-18s%b" "$C6" "                   " "$C0"
p "Memory:" "$MEMORY"

printf "%b%-18s%b" "$C1" "                   " "$C0"
p "Shell:" "$SHELL_NAME"

printf "%18s" "                   "
p "Terminal:" "$TERM_NAME"

#printf "%18s" ""
#p "Packages:" "$PKG"

printf "\n"
